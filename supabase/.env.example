# Copia este archivo a supabase/.env (ignorado por git) y completa los valores.
# Client ID del OAuth de Google de producción + el secret creado para desarrollo
# (no el secret que usa el proyecto de prod). Pídelos a un organizador por privado.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
